# ---------------------------------------------------------------------------
# JobFinder - environment configuration
#
# ISOLATION NOTE
# This project is deliberately kept separate from the existing LinkedIn/Dice
# auto-apply project. Every port, database name, storage path and log path
# below is chosen to avoid collision. Do not point these at the other project.
#
# Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=JobFinder
ENVIRONMENT=local
DEBUG=true

# Dedicated port. 8000 is intentionally avoided: it is used by the other project.
API_HOST=127.0.0.1
API_PORT=8100

# --- Database --------------------------------------------------------------
# Dedicated database on the existing local PostgreSQL 16 server (port 5432).
#
# DO NOT point this at `linkedin_auto_apply`. That database belongs to the
# separate LinkedIn/Dice project and must never be connected to, migrated or
# inspected from here. This project owns `resume_job_discovery` only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resume_job_discovery
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# If you use the bundled docker-compose stack instead of the local server,
# set POSTGRES_PORT=5433 (compose publishes there to avoid colliding with 5432).

# Optional: overrides the six vars above when set. Must use the asyncpg driver.
# DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/resume_job_discovery

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
# Provisioned for later phases (background search workers). Unused in Phase 1.
# Port 6380 avoids collision with a default local Redis on 6379.
REDIS_URL=redis://127.0.0.1:6380/0

# --- CORS (Lovable React frontend) ----------------------------------------
# Comma-separated exact origins.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
# Regex for Lovable's rotating preview subdomains. Leave blank to disable.
CORS_ALLOW_ORIGIN_REGEX=^https://.*\.lovable(project)?\.app$
CORS_ALLOW_CREDENTIALS=true

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# json for production/aggregation, console for readable local development
LOG_FORMAT=console

# --- Storage ---------------------------------------------------------------
# Dedicated directories. Do not share with the other project.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# --- Domain rules (locked by CLAUDE.md) -----------------------------------
# Minimum match score. CLAUDE.md section 18: never lower this to fill quotas.
MIN_MATCH_SCORE=70
# CLAUDE.md section 4: at most 8 portals enabled at one time.
MAX_ENABLED_PORTALS=8
